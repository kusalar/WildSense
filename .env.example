# WildSense Environment Configuration
PYTHONPATH=backend
# Set HOST=0.0.0.0 to allow mobile devices on the same Wi-Fi LAN to connect
HOST=0.0.0.0
PORT=8000

# Optional Frontend API Base URL override (defaults to auto-detecting http://<hostname>:8000/api)
# NEXT_PUBLIC_API_URL=http://192.168.0.193:8000/api

# Ollama / Local AI Model Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
REASONING_PROVIDER=ollama
REASONING_MODEL=qwen3:4b
GEMMA_MODEL=gemma2:2b
VISION_MODEL=moondream

# Audio Narration Provider Configuration (Task 6)
# Options: "browser" (default offline speech synthesis) or "elevenlabs" (high-quality optional cloud narration)
AUDIO_PROVIDER=browser

# Optional ElevenLabs Settings (Used only if AUDIO_PROVIDER=elevenlabs or requested)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Stage 5 Indian Flora Specialist Feature Flag (disabled by default)
ENABLE_INDIAN_FLORA_SPECIALIST=false
